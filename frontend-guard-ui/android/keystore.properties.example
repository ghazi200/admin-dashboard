# Copy to keystore.properties in this same folder (android/) and fill in values.
# NEVER commit keystore.properties or the .keystore / .jks file.
#
# Create the keystore once:
#   keytool -genkey -v -keystore "$HOME/guard-ui-upload.keystore" -alias guardui \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile can be absolute or relative to android/app/

storePassword=YOUR_STORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=guardui
storeFile=/Users/YOUR_USER/guard-ui-upload.keystore
