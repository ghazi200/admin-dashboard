# Admin Dashboard Backend — copy to .env and fill in values.
# See docs/CONFIGURATION_AND_ENV.md and CORS.md for details.

# --- Required (production) ---
# 1. For production deployment set NODE_ENV=production (required for strict CORS, JWT check, etc.)
NODE_ENV=production
# Local: use the line below. Railway: paste DATABASE_URL from the next line into Railway → Variables.
DATABASE_URL=postgresql://user:password@localhost:5432/abe_guard
# DATABASE_URL=${{ Postgres.DATABASE_URL }}
JWT_SECRET=your-secret-at-least-16-characters-long

# --- Optional: DB (if not using DATABASE_URL) ---
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=abe_guard
# DB_USER=user
# DB_PASS=password

# --- Optional: Server ---
PORT=5000

# --- Realtime (WebSocket Gateway + Redis) ---
# Required for realtime events. Railway: REDIS_URL=${{ Redis.REDIS_URL }}
REDIS_URL=redis://localhost:6379

# --- Production CORS (required when frontend is on a different origin) ---
# In production the backend uses strict CORS automatically (Capacitor + localhost still allowed).
# Comma-separated list of allowed web origins. Add your Vercel URLs and custom domains.
CORS_ORIGINS=https://admin-dashboard-frontend-flax.vercel.app,https://admin-dashboard-frontend-techworldstarzllcs-projects.vercel.app,https://frontend-guard-ui.vercel.app
# Emergency only (never on public beta): CORS_ALLOW_ALL=true
# GUARD_APP_URL=https://guard.example.com
# ADMIN_APP_URL=https://admin.example.com

# --- Beta / production gates (Phase 0) ---
# Registration is OFF in production unless explicitly enabled:
# ALLOW_ADMIN_REGISTER=true
# Dev seed routes (/api/dev/*) are OFF when NODE_ENV=production (no env override).

# --- Optional: Rate limiting ---
# RATE_LIMIT_MAX=500
# (default 500 per 15 min per IP; increase if AI Agent 24 / assistant hits "Too many requests")
# AUTH_RATE_LIMIT_MAX=10

# --- Optional: Debug / tuning ---
# DEBUG_STARTUP=true
# DEBUG_DASHBOARD=true
# STARTUP_TIMEOUT_MS=45000
# UNFILLED_SHIFT_CHECK_INTERVAL_MINUTES=5

# --- Optional: MFA (Twilio SMS + policy) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# B3 — require MFA for pilot / all tenant admins (see docs/MFA_ONBOARDING.md):
# MFA_REQUIRED=true
# MFA_REQUIRED_TENANT_IDS=uuid-of-pilot-tenant
# MFA_REQUIRED_FOR_SUPER_ADMIN=false


# --- Optional: Cron (shift reminders via HTTP) ---
# Required in production — cron endpoint returns 503 without this:
CRON_SECRET=random-secret-for-get-/api/cron/shift-reminders
# Optional: /health/cron returns 503 if no job success within this window (ms), default 15 min
# CRON_STALE_AFTER_MS=900000

# --- Phase 2: AI callout proxy (admin backend → abe-guard-ai service) ---
# Required on admin Railway service before callouts work in the guard app:
# ABE_GUARD_AI_URL=https://your-guard-ai-xxxx.up.railway.app
# Guard AI service uses the SAME DATABASE_URL and JWT_SECRET as this backend.
# See docs/BETA_PHASE_2.md
#
# After ranking, THIS admin service emails/texts replacements (in-app is separate):
# SMTP_HOST / SMTP_USER / SMTP_PASS / SMTP_FROM  → email ranked guards
# TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN
# TWILIO_MESSAGING_SERVICE_SID (or TWILIO_PHONE_NUMBER) → SMS ranked guards
# Optional: CALLOUT_MAX_GUARDS_NOTIFY=10
# Pause outbound while not testing (in-app callouts still work):
# CALLOUT_OUTBOUND_EMAIL=false
# CALLOUT_OUTBOUND_SMS=false
# After a guard accepts an OPEN shift, admins/supervisors get this many minutes
# to override before the shift is finalized CLOSED (default 7, clamped 5–30):
# ACCEPT_OVERRIDE_MINUTES=7
# External cron (every 1–2 min): GET /api/cron/finalize-pending-accepts?secret=CRON_SECRET

# Live voice offers (Twilio Calls — charges apply). Opt-in:
# CALLOUT_OUTBOUND_CALL=true
# Also accepted: CALLOUT_ENABLE_VOICE_CALL=true
# Voice needs a real From number (not Messaging Service alone):
# TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
# Twilio must fetch TwiML from your public admin URL:
# PUBLIC_BASE_URL=https://admin-dashboard-production-2596.up.railway.app
# Call script: press 1 accept / press 2 decline → /twilio/voice
# SMS/voice/email outbound also requires guards.communications_consent = true
# (set via Admin → Guards create/edit checkbox). Policy page:
# /legal/messaging-consent
# Optional A2P: append consent URL on callout SMS (needs PUBLIC_BASE_URL):
# CALLOUT_SMS_INCLUDE_CONSENT_LINK=true
# Legal pack (B4): /legal/privacy /legal/terms /legal/ — see docs/legal/
# Migration: node scripts/run-guard-communications-consent-migration.js

# --- Optional: AI / external services (Command Center weekly report + briefing) ---
# Prefer DeepSeek when funded; OpenAI is tried as fallback (and vice versa).
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# RESET_DB=false
